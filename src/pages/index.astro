---
// Landing page para Codbyte
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Trabajos from '../components/Trabajos.astro';
import Paquetes from '../components/Paquetes.astro';
import PorQue from '../components/PorQue.astro';
import Proceso from '../components/Proceso.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';

const title = `${site.name} | Sitios web y Google para negocios de Tucumán`;
const description = `Sitios web, catálogos y Perfil de Empresa en Google para negocios locales de ${site.city}. Te mostramos la demo antes de que contrates.`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:locale" content="es_AR">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="font-sans text-gray-800">
  <Header />
  <main>
    <Hero />
    <Servicios />
    <Trabajos />
    <Paquetes />
    <PorQue />
    <Proceso />
    <Contacto />
  </main>
  <Footer />
</body>
</html>
