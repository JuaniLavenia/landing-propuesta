---
// Header - Navegación fija
import { site } from '../config/site';
---
<header class="fixed top-0 w-full bg-white/95 backdrop-blur shadow-sm z-50">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <a href="/" class="text-xl font-bold text-brand-700">{site.name}</a>
    <nav class="hidden md:flex gap-6">
      <a href="#servicios" class="text-gray-700 hover:text-brand-700">Servicios</a>
      <a href="#trabajos" class="text-gray-700 hover:text-brand-700">Trabajos</a>
      <a href="#paquetes" class="text-gray-700 hover:text-brand-700">Paquetes</a>
      <a href="#por-que" class="text-gray-700 hover:text-brand-700">Por qué nosotros</a>
    </nav>
    <a href="#contacto" class="bg-brand-600 text-white px-5 py-2 rounded-full hover:bg-brand-700 transition">Contactar</a>
  </div>
</header>
