---
// Footer
import { site } from '../config/site';
---
<footer class="bg-dark text-white py-12">
  <div class="container mx-auto px-4 text-center">
    <h3 class="text-2xl font-bold text-brand-400 mb-4">{site.name}</h3>
    <p class="text-gray-400 mb-6">{site.tagline}. {site.city}, Argentina.</p>
    <p class="text-gray-500 text-sm">© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
  </div>
</footer>
